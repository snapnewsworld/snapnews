---
import Base from '../layouts/Base.astro';
import SnapCheck from '../components/SnapCheck.astro';
import { SITE } from '../consts';
---
<Base title="Contact" description="How to reach Snap News.">
  <header class="page-head">
    <span class="kicker">Contact</span>
    <h1>Get in touch</h1>
    <p>Spotted a mistake, have a tip, or want to suggest a story? We read everything.</p>
  </header>

  <div class="contact">
    {SITE.contactEmail
      ? <SnapCheck email={SITE.contactEmail} />
      : <p class="empty">A contact address is coming soon.</p>}

    <h2>Corrections</h2>
    <p>If we got a fact wrong, tell us which article and send a source. Corrections are noted at the top of the article.</p>

    <h2>Your privacy</h2>
    <p>This site has no trackers, no ads and no analytics. Nothing about your visit is recorded by us.</p>
  </div>
</Base>

<style>
  .contact { max-width: var(--measure); font-size: 1.05rem; }
  .contact h2 { font-size: 1.15rem; margin: 2rem 0 .4rem; }
  .contact p { color: var(--ink-soft); }
</style>
