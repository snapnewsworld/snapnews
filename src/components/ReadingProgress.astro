---
// Thin bar at the very top of the screen showing how far through the article the reader is.
// Fixed-position and transform-only, so it never shifts the layout.
---
<div class="reading-progress" aria-hidden="true"><div class="reading-progress-fill"></div><span class="reading-progress-spark"></span></div>

<script>
  const fill = document.querySelector<HTMLElement>('.reading-progress-fill');
  const article = document.querySelector<HTMLElement>('[data-progress-target]');
  if (fill && article) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      fill.style.transform = `scaleX(${p})`;
      // Finished the piece? The bar goes "snap".
      fill.parentElement?.classList.toggle('done', p >= 0.995);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .reading-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 60; pointer-events: none; }
  .reading-progress-fill {
    height: 100%; background: var(--accent);
    transform: scaleX(0); transform-origin: 0 50%;
    transition: transform .08s linear;
  }
  .reading-progress-spark {
    position: absolute; right: 0; top: -7px; width: 16px; height: 16px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 18%, var(--accent) 30%, transparent 70%);
    opacity: 0; transform: scale(.2);
  }
  .done .reading-progress-spark { animation: finish-snap .6s ease-out forwards; }
  .done .reading-progress-fill { box-shadow: 0 0 10px var(--accent); }
  @keyframes finish-snap {
    40% { opacity: 1; transform: scale(1.6); }
    100% { opacity: 0; transform: scale(2.4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress-fill { transition: none; }
    .done .reading-progress-spark { animation: none; }
  }
  @media print { .reading-progress { display: none; } }
</style>
